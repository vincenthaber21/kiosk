# Copy this file to .env and adjust values for your environment.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave unset (or use the sqlite URL below) to run locally without Postgres.
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://credit_user:credit_pass@localhost:5432/credit_service

# Email (dev uses console backend regardless)
DEFAULT_FROM_EMAIL=credit-service@example.com

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
