{
  "name": "GengloPrintingServices",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "sync:icon": "node scripts/sync-app-icon-from-store.mjs",
    "eas-build-post-install": "node scripts/sync-app-icon-from-store.mjs",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start",
    "start:clear": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --clear",
    "start:tunnel": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --tunnel",
    "start:lan": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --lan",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --android",
    "android:clear": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --android --clear",
    "ios": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --web",
    "clean": "node clear-cache.js",
    "clean:all": "npm run clean && npm cache clean --force"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.2",
    "expo": "~54.0.0",
    "expo-camera": "^55.0.15",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "babel-preset-expo": "~54.0.0",
    "cross-env": "^7.0.3",
    "sharp": "^0.33.5"
  },
  "private": true
}
